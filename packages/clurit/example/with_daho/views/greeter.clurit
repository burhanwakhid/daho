@code {
    final pageTitle = 'Greeter';

    var greetIndex = $state(0);
    final names = ['Alice', 'Bob', 'Charlie'];
    final currentName = $derived.by(() {
        return names[greetIndex % names.length];
    });

    void nextName() {
        greetIndex = greetIndex + 1;
    }
}

@extends('layouts.main')

@section('content')
    <div class="bg-white rounded-lg shadow p-6">
        <h1 class="text-2xl font-bold mb-4">Hello, {{ $currentName }}!</h1>
        <button cl-click="nextName" class="px-3 py-1 rounded bg-blue-600 text-white">Next Person</button>
    </div>
@endsection
