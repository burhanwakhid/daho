    @if($items != null && $items.isNotEmpty)
        <h2>Items</h2>
        <ul>
            @foreach($items as $item)
                <li class="{{ $loop->first ? 'first' : '' }}">
                    {{ $loop->iteration }}. {{ $item }}
                </li>
            @endforeach
        </ul>
    @else
        <p>No items to display.</p>
