# https://dart.dev/guides/libraries/private-files
# Created by `dart pub`
.dart_tool/

# Avoid committing pubspec.lock for library packages; see
# https://dart.dev/guides/libraries/private-files#pubspeclock.
pubspec.lock

# Native build output (generated by CMake; contains machine-absolute paths).
# Build it with `cmake --build` / the daho CLI, never commit it.
**/c_src/build/

# Compiled native libraries
*.dylib
*.so
*.dll
*.o

# Local databases produced by examples
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Claude Code local settings
.claude/
*.exe

# Node.js (VitePress docs)
node_modules/
.vitepress/dist/
.vitepress/cache/

# Compiled clurit client bundles (`dart compile js`/`dart compile wasm`) —
# build output, not source; regenerate with
# `dart compile js web/main.g.dart -o web/main.dart.js` /
# `dart compile wasm web/main.g.dart -o web/main.dart.wasm`.
**/example/**/web/main.dart.js
**/example/**/web/main.dart.js.deps
**/example/**/web/main.dart.js.map
**/example/**/web/main.dart.js_*.part.js
**/example/**/web/main.dart.js_*.part.js.map
**/example/**/web/main.dart.wasm
**/example/**/web/main.dart.wasm.map
**/example/**/web/main.dart.mjs

# JetBrains IDE project files
.idea/

# Compiled Go binary from the benchmark comparison server — build with
# `go build -o fiber_server .` inside packages/daho/benchmark/fiber, never commit.
packages/daho/benchmark/fiber/fiber_server
